# ============================================================
# Root .env.example — dipakai oleh docker-compose.yml
# Salin ke .env dan sesuaikan nilainya sebelum menjalankan.
# JANGAN pernah commit file .env asli ke repositori.
# ============================================================

# --- Database PostgreSQL ---
DB_DATABASE=marketplace_db
DB_USERNAME=marketplace_user
DB_PASSWORD=marketplace_pass

# --- Laravel App Key (isi setelah php artisan key:generate) ---
APP_KEY=

